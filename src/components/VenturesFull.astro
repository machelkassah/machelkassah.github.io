---
import { ventures } from "../data/ventures";
---

<div class="ventures-full">
  {ventures.map((venture) => (
    <article class="venture-row card">
      <span class="venture-row__mark" aria-hidden="true">{venture.name.charAt(0)}</span>
      <div class="venture-row__body">
        <h2>{venture.name}</h2>
        <p class="venture-row__description">{venture.description}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .ventures-full {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .venture-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-4);
  }

  .venture-row__mark {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.4;
  }

  .venture-row__description {
    max-width: 48ch;
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .venture-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .venture-row__mark {
      font-size: 1.75rem;
    }
  }
</style>
