---
import { site } from "../data/site";
import { aboutSecondaryImage } from "../data/images";
import ImagePlaceholder from "./ImagePlaceholder.astro";
---

<section id="about" class="about section">
  <div class="container about__grid">
    <div class="about__copy">
      <h2>About</h2>
      {site.about.paragraphs.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
    </div>
    <div class="about__photo-frame">
      <ImagePlaceholder
        src={aboutSecondaryImage.src}
        alt={aboutSecondaryImage.alt}
        guidance={aboutSecondaryImage.guidance}
        aspect={aboutSecondaryImage.aspect}
      />
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .about__copy p {
    font-size: 1.1rem;
    max-width: 56ch;
  }

  .about__photo-frame {
    max-width: 20rem;
    margin-left: auto;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 800px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__photo-frame {
      max-width: 16rem;
      margin: 0 auto;
    }
  }
</style>
