---
import { site } from "../data/site";
import { aboutSecondaryImage } from "../data/images";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import InkSplash from "./InkSplash.astro";
---

<section id="about" class="about section section--decorated">
  <div class="container about__grid">
    <div class="about__copy">
      <h2>About</h2>
      {site.about.paragraphs.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
    </div>
    <div class="about__photo-wrap">
      <InkSplash color="teal" size="27rem" top="-6.5rem" right="-7.5rem" rotate="-12deg" />
      <div class="about__photo-frame">
        <ImagePlaceholder
          src={aboutSecondaryImage.src}
          alt={aboutSecondaryImage.alt}
          guidance={aboutSecondaryImage.guidance}
          aspect={aboutSecondaryImage.aspect}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .about__copy p {
    font-size: 1.1rem;
    max-width: 56ch;
  }

  .about__photo-wrap {
    position: relative;
    max-width: 20rem;
    margin-left: auto;
  }

  .about__photo-frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 800px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__photo-wrap {
      max-width: 16rem;
      margin: 0 auto;
    }
  }
</style>
