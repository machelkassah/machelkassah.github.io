---
import { ventures } from "../data/ventures";
import InkSplash from "./InkSplash.astro";
---

<section id="ventures" class="ventures-preview section section--decorated">
  <InkSplash color="accent" size="9rem" top="1rem" right="4rem" rotate="18deg" />
  <div class="container">
    <h2>Ventures</h2>
    <div class="ventures-preview__ledger">
      {ventures.map((venture) => (
        <article class="ventures-preview__row card">
          <h3>{venture.name}</h3>
          <p>{venture.description}</p>
        </article>
      ))}
    </div>
    <a class="btn btn--secondary" href="/ventures">View all ventures</a>
  </div>
</section>

<style>
  .ventures-preview__ledger {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-4);
  }

  .ventures-preview__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3);
  }

  .ventures-preview__row p {
    margin: 0;
    max-width: 48ch;
  }

  @media (max-width: 640px) {
    .ventures-preview__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
