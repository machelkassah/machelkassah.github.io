---
import { ventures } from "../data/ventures";
---

<section id="ventures" class="ventures-preview section">
  <div class="container">
    <h2>Ventures</h2>
    <div class="ventures-preview__ledger">
      {ventures.map((venture) => (
        <article class="ventures-preview__row">
          <h3>{venture.name}</h3>
          <p>{venture.description}</p>
        </article>
      ))}
    </div>
    <a class="btn btn--secondary" href="/ventures">View all ventures</a>
  </div>
</section>

<style>
  .ventures-preview__ledger {
    margin: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .ventures-preview__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .ventures-preview__row p {
    margin: 0;
    max-width: 48ch;
  }

  @media (max-width: 640px) {
    .ventures-preview__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
