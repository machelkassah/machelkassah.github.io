---
import { site } from "../data/site";
import { heroImage } from "../data/images";
import { experience } from "../data/experience";
import { contact } from "../data/contact";
import ImagePlaceholder from "./ImagePlaceholder.astro";

const currentRole = experience[0];
---

<section id="home" class="hero section">
  <div class="container hero__grid">
    <div class="hero__copy">
      <div class="hero__status reveal reveal-1">
        <span class="status-dot status-dot--live" aria-hidden="true"></span>
        <p class="readout">{site.headline}</p>
      </div>
      <h1 class="hero__name reveal reveal-2">{site.name}</h1>
      <p class="hero__positioning reveal reveal-3">{site.positioningStatement}</p>
      <dl class="hero__facts reveal reveal-3">
        <div class="hero__fact">
          <dt class="label">Role</dt>
          <dd>{currentRole.role}</dd>
        </div>
        <div class="hero__fact">
          <dt class="label">Location</dt>
          <dd>{contact.location}</dd>
        </div>
      </dl>
      <div class="hero__ctas reveal reveal-4">
        <a class="btn btn--primary" href={site.heroCtaPrimary.href}>{site.heroCtaPrimary.label}</a>
        <a class="btn btn--secondary" href={site.heroCtaSecondary.href}>{site.heroCtaSecondary.label}</a>
      </div>
    </div>
    <div class="hero__portrait reveal reveal-2">
      <ImagePlaceholder
        src={heroImage.src}
        alt={heroImage.alt}
        guidance={heroImage.guidance}
        aspect={heroImage.aspect}
      />
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .hero__status {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .hero__name {
    margin: 0 0 var(--space-3);
  }

  .hero__positioning {
    max-width: 46ch;
    font-size: 1.1rem;
  }

  .hero__facts {
    display: flex;
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .hero__fact dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hero__portrait {
    max-width: 15rem;
    margin-left: auto;
    padding-top: var(--space-1);
  }

  @media (max-width: 800px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__portrait {
      max-width: 12rem;
      margin: 0 0 var(--space-3);
      order: -1;
    }
    .hero__facts {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
  }
</style>
