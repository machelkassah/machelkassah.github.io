---
import { skills } from "../data/skills";
import SkillIcon from "./SkillIcon.astro";
import Blob from "./Blob.astro";

const categoryIcon: Record<string, "paintbrush" | "laptop" | "wrench" | "server" | "briefcase"> = {
  "Digital & Creative": "paintbrush",
  "Software Development": "laptop",
  "Operations & Compliance": "wrench",
  "Infrastructure & Deployment": "server",
  "Business & Leadership": "briefcase",
};
---

<section id="skills" class="skills section section--decorated">
  <Blob color="teal" size="22rem" bottom="-10rem" right="-8rem" />
  <div class="container">
    <h2>Skills</h2>
    <div class="skills__grid">
      {skills.map((group) => (
        <div class="skills__group card">
          <div class="skills__group-head">
            <p class="label">{group.category}</p>
            {categoryIcon[group.category] && <SkillIcon type={categoryIcon[group.category]} />}
          </div>
          <ul class="skills__items">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .skills__group {
    padding: var(--space-3);
  }

  .skills__group-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .skills__group-head :global(.skill-icon) {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    color: var(--color-teal);
  }

  .skills__items {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }

  .skills__items li {
    font-size: 0.9rem;
  }

  .skills__items li:not(:last-child)::after {
    content: "·";
    margin-left: 0.6rem;
    color: var(--color-ink-muted);
  }
</style>
